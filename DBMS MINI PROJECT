SELECT
    b.book_id,
    b.title,
    b.author,
    c.category_name,
    b.price
FROM Book b
JOIN Category c
ON b.category_id = c.category_id;
SELECT
    c.customer_id,
    c.name,
    o.order_id,
    o.order_date,
    o.total_amount,
    o.status
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id;
